# Copy to .env and fill in. .env is gitignored.
# Plain KEY=value data only (no shell syntax). Any key here overrides the
# built-in defaults and the profile; launch flags override this file.

# --- AWS ---
# Prefer a named profile (`aws configure --profile mc` or SSO) over raw keys.
AWS_PROFILE=default
AWS_REGION=ca-central-1

# --- SSH ---
# The key pair is created (or your existing key imported) on first launch.
KEY_NAME=lockoutserver
KEY_PATH=~/.ssh/lockoutserver.pem
# Who may SSH in: "auto" = your current public IP, or a CIDR like 1.2.3.4/32
SSH_CIDR=auto

# --- Launch defaults ---
PROFILE=lockout
INSTANCE_TYPE=c7i.xlarge

# --- Players (space-separated Minecraft usernames) ---
OPS=
# Setting a whitelist turns it on; ops are always whitelisted too.
WHITELIST=

# --- Where instances download mods from ---
REPO_RAW_URL=https://raw.githubusercontent.com/IanLeung12/lockoutserver
REPO_REF=main
